{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./bot",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "noImplicitAny": false,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./bot",
    "paths": {
      "*": ["*"]
    }
  },
  "include": ["bot/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "admin"]
}
