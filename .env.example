# ==========================================
# RENDER
# ==========================================
NODE_ENV=production
PORT=3000
RENDER_EXTERNAL_URL=https://seu-bot.onrender.com

# ==========================================
# BANCO DE DADOS (Render PostgreSQL)
# ==========================================
DB_HOST=seu_host.render.com
DB_PORT=5432
DB_USER=seu_user
DB_PASS=sua_senha
DB_NAME=fofoca_bot

# ==========================================
# REDIS (Render Redis - OPCIONAL)
# ==========================================
REDIS_URL=redis://seu_redis_url

# ==========================================
# TELEGRAM
# ==========================================
TELEGRAM_BOT_TOKEN=seu_token_aqui

# ==========================================
# MERCADO PAGO
# ==========================================
MERCADO_PAGO_ACCESS_TOKEN=seu_token_mp
MERCADO_PAGO_PUBLIC_KEY=sua_public_key
MERCADO_PAGO_WEBHOOK_SECRET=seu_secret

# ==========================================
# SEGURANÇA
# ==========================================
JWT_SECRET=seu_jwt_secret_aqui
