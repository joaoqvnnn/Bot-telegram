# ==========================================
# AMBIENTE
# ==========================================
NODE_ENV=development
PORT=3000
APP_NAME=Fofoca Bot
APP_URL=http://localhost:3000

# ==========================================
# BANCO DE DADOS
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=fofoca_bot

# ==========================================
# REDIS
# ==========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ==========================================
# TELEGRAM
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ==========================================
# MERCADO PAGO
# ==========================================
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# ==========================================
# E-MAIL
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@fofocabot.com

# ==========================================
# SEGURANÇA
# ==========================================
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==========================================
# ADMIN
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_2FA_SECRET=

# ==========================================
# LOGS
# ==========================================
LOG_LEVEL=info
SENTRY_DSN=
